generator client {

  provider = "prisma-client-js"

}

datasource db {

  provider = "postgresql"

} 


// --- ENUMS (Các tùy chọn cố định) ---
enum Role {
  USER
  AGENT
  ADMIN
}

enum TransactionType {
  SALE
  RENT
  PROJECT
}

enum ListingStatus {
  PENDING
  ACTIVE
  SOLD
  HIDDEN
}

// --- CÁC BẢNG MỚI (User, Category, Image, Favorite, Message) ---
model User {
  id               String     @id @default(uuid())
  email            String     @unique
  password         String
  fullName         String
  phoneNumber      String?    @unique
  avatarUrl        String?
  role             Role       @default(USER)

  posts            posts[]    // Liên kết với bảng posts cũ
  favorites        Favorite[]

  // ---- Quan hệ với bảng Message (Chat) ----
  sentMessages     Message[]  @relation("SentMessages")
  receivedMessages Message[]  @relation("ReceivedMessages")

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique

  posts     posts[]
}

model Image {
  id        String    @id @default(uuid())
  url       String
  postId    Int       // Khóa ngoại trỏ về posts.id
  
  post      posts     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String    @id @default(uuid())
  userId    String
  postId    Int       // Khóa ngoại trỏ về posts.id

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      posts     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

// --- BẢNG TIN NHẮN (CHAT) ---
model Message {
  id         Int      @id @default(autoincrement())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  text       String
  createdAt  DateTime @default(now()) @map("created_at")

  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("messages") // Map tên bảng xuống database là "messages" để đồng bộ với Frontend
}

// --- CÁC BẢNG CŨ (Được giữ nguyên để không mất Data) ---
model cities {
  code           String      @id @db.VarChar(10)
  name           String      @db.VarChar(255)
  slug           String?     @db.VarChar(255)
  type           String?     @db.VarChar(50)
  name_with_type String?     @db.VarChar(255)
  districts      districts[]
  posts          posts[]
}

model districts {
  code           String      @id @db.VarChar(10)
  name           String      @db.VarChar(255)
  type           String?     @db.VarChar(50)
  slug           String?     @db.VarChar(255)
  name_with_type String?     @db.VarChar(255)
  path           String?     @db.VarChar(255)
  path_with_type String?     @db.VarChar(255)
  parent_code    String?     @db.VarChar(10)
  cities         cities?     @relation(fields: [parent_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  posts          posts[]
}

// --- BẢNG POSTS CŨ (Được nâng cấp thêm tính năng) ---
model posts {
  id              Int             @id @default(autoincrement())
  sourceId        String?         @unique
  title           String          @db.VarChar(255)
  thumbnail       String?
  price           Decimal         @db.Decimal
  area            Decimal         @db.Decimal
  city            String?         @db.VarChar(10)
  district        String?         @db.VarChar(10)
  content         String?

  ward            String?         
  addressDetail   String?         
  bedrooms        Int?            
  bathrooms       Int?            
  direction       String?         
  floors          Int?            
  length          Float?          
  width           Float?          
  legalDocument   String?         
  furnishing      String?         

  sellerName      String?       // <--- THÊM CỘT NÀY VÀO ĐỂ LƯU TÊN NGƯỜI ĐĂNG

  transactionType TransactionType @default(SALE)
  status          ListingStatus   @default(PENDING)

  // ... (các quan hệ bên dưới giữ nguyên không đổi)
  userId          String?
  categoryId      Int?

  // ---- QUAN HỆ VỚI CÁC BẢNG KHÁC ----
  cities          cities?         @relation(fields: [city], references: [code], onDelete: NoAction, onUpdate: NoAction)
  districts       districts?      @relation(fields: [district], references: [code], onDelete: NoAction, onUpdate: NoAction)
  user            User?           @relation(fields: [userId], references: [id])
  category        Category?       @relation(fields: [categoryId], references: [id])
  images          Image[]
  favorites       Favorite[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt
}