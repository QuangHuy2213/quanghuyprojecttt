generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS (Các tùy chọn cố định) ---
enum Role {
  USER
  AGENT
  ADMIN
}

enum TransactionType {
  SALE
  RENT
  PROJECT
}

enum ListingStatus {
  PENDING
  ACTIVE
  SOLD
  HIDDEN
}

// Các loại thông báo
enum NotificationType {
  MESSAGE       // Thông báo tin nhắn mới
  SYSTEM        // Thông báo hệ thống (bảo mật, chào mừng...)
  POST_UPDATE   // Thông báo cập nhật bài đăng (duyệt, từ chối...)
  WARNING_POPUP // Thông báo cảnh báo gian lận (Hiển thị dạng Modal chặn màn hình)
}

// Enums cho Bảng Giao Dịch (Transaction/Escrow)
enum EscrowStatus {
  VERIFYING               // Chờ 2 bên xác nhận
  SUCCESS                 // Đã xác nhận thành công
  FRAUD                   // Gian lận, trốn phí
  DISPUTE                 // Tranh chấp (1 CÓ, 1 KHÔNG hoặc Kháng cáo Hủy)
  CANCELLED               // Khách hoặc Chủ đều chọn KHÔNG (Chưa giao dịch)
  PENDING_CANCEL          // Đang chờ đối tác đồng ý hủy
  CANCELLED_AFTER_SUCCESS // Hủy kèo phút chót (Sau khi đã bấm SUCCESS)
}

// Enums cho Bảng Hóa Đơn (Invoice)
enum InvoiceStatus {
  DRAFT             // Nháp (Hệ thống vừa tạo, chờ Admin duyệt gửi đi)
  PENDING_PAYMENT   // Đang chờ thanh toán (Đã gửi cho User, đang đếm ngược 30 ngày)
  PAID              // Đã thanh toán thành công
  OVERDUE           // Quá hạn (User chưa thanh toán sau 30 ngày -> Auto Khóa tài khoản)
  CANCELLED         // Đã hủy (Nếu giao dịch bị CANCELLED_AFTER_SUCCESS)
}

// Enum cho Người đăng tin
enum PosterType {
  OWNER       // Chủ nhà
  BROKER      // Môi giới
}

// --- CÁC BẢNG ---

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String?
  fullName        String
  phoneNumber     String?   @unique
  avatarUrl       String?
  googleId        String?   @unique
  role            Role      @default(USER)
  isLocked        Boolean   @default(false)
  lockReason      String?   // Lý do khóa (VD: Gian lận giao dịch, Không đóng phí)
  agentExpiresAt  DateTime? // Hạn sử dụng gói Môi Giới 299k

  posts     posts[]
  favorites Favorite[]

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  notifications Notification[]
  reports       Report[]
  comments      Comment[]
  commentLikes  CommentLike[]
  postReviews   PostReview[]
  areaReviews   AreaReview[]
  following     Follow[] @relation("UserFollowing")
  followers     Follow[] @relation("UserFollowers")

  // Mối quan hệ với bảng Transaction
  boughtTransactions Transaction[] @relation("BuyerTransactions")
  soldTransactions   Transaction[] @relation("SellerTransactions")

  // Danh sách hóa đơn user cần thanh toán
  invoices Invoice[] 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id    Int     @id @default(autoincrement())
  name  String
  slug  String  @unique
  posts posts[]
}

model Image {
  id     String @id @default(uuid())
  url    String
  postId Int
  post   posts  @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Favorite {
  id     String @id @default(uuid())
  userId String
  postId Int

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  post posts @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  userId    String
  postId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      posts    @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  Int?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  likes     CommentLike[]
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model CommentLike {
  userId String
  commentId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, commentId])
}

model PostReview {
  id Int @id @default(autoincrement())
  rating Int
  content String
  userId String
  postId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post posts @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, postId])
}

model AreaReview {
  id Int @id @default(autoincrement())
  userId String
  cityCode String
  districtCode String
  security Int
  traffic Int
  amenities Int
  environment Int
  affordability Int
  content String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, districtCode])
  @@index([districtCode])
}

model Follow {
  followerId String
  followingId String
  follower User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([followerId, followingId])
  @@index([followingId])
}

// --- BẢNG TIN NHẮN (CHAT) ---
model Message {
  id         Int      @id @default(autoincrement())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  text       String
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// --- BẢNG THÔNG BÁO ---
model Notification {
  id        Int              @id @default(autoincrement())
  userId    String           @map("user_id")
  title     String
  content   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// --- BÁO CÁO VI PHẠM ---
model Report {
  id           Int      @id @default(autoincrement())
  userId       String   // Người thực hiện báo cáo
  postId       Int?     // Bài đăng bị báo cáo (nếu có)
  targetUserId String?  // Hoặc tài khoản bị báo cáo (nếu có)
  reason       String   // Lý do báo cáo
  status       String   @default("PENDING") // PENDING, RESOLVED, IGNORED
  createdAt    DateTime @default(now())

  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post posts? @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// --- LIÊN HỆ & TRỢ GIÚP ---
model Contact {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String
  subject   String
  message   String
  status    String   @default("PENDING") // PENDING, REPLIED
  createdAt DateTime @default(now())
}

// --- BẢNG LƯU TRỮ GIAO DỊCH (ĐỐI SOÁT CHÉO / ESCROW) ---
model Transaction {
  id      String @id @default(uuid())
  postId  Int
  buyerId String // Khách hàng (User)
  sellerId String // Môi giới hoặc Chủ nhà (Agent/User)

  buyerConfirmed  Boolean? // Khách xác nhận (true/false/null)
  sellerConfirmed Boolean? // Người bán xác nhận (true/false/null)

  calculatedFee Decimal?     @db.Decimal // Tiền phí App dự tính thu
  status        EscrowStatus @default(VERIFYING)

  // 🌟 Đã bổ sung 2 trường lưu vết Yêu cầu Hủy kèo phút chót
  cancelInitiatorId String?  // Ghi nhận ID của người bấm nút báo cáo hủy kèo
  cancelReason      String?  // Lưu lại lý do hủy

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   posts @relation(fields: [postId], references: [id], onDelete: Cascade)
  buyer  User  @relation("BuyerTransactions", fields: [buyerId], references: [id])
  seller User  @relation("SellerTransactions", fields: [sellerId], references: [id])

  // Mối quan hệ 1-1 với Bảng Hóa đơn
  invoice Invoice?
}

// --- BẢNG HÓA ĐƠN THU PHÍ GIAO DỊCH ---
model Invoice {
  id            String        @id @default(uuid())
  transactionId String        @unique // 1 Giao dịch thành công chỉ có 1 Hóa đơn
  userId        String        // Mã người phải trả tiền (Seller/Broker)
  
  amount        Decimal       @db.Decimal // Số tiền phải thanh toán
  status        InvoiceStatus @default(DRAFT)
  
  dueDate       DateTime?     // Hạn chót thanh toán (Cộng 30 ngày từ khi Admin duyệt)
  paidAt        DateTime?     // Thời gian đã thanh toán thực tế
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- BẢNG HÀNH CHÍNH & BÀI ĐĂNG ---
model cities {
  code           String      @id @db.VarChar(10)
  name           String      @db.VarChar(255)
  slug           String?     @db.VarChar(255)
  type           String?     @db.VarChar(50)
  name_with_type String?     @db.VarChar(255)
  districts      districts[]
  posts          posts[]
}

model districts {
  code           String  @id @db.VarChar(10)
  name           String  @db.VarChar(255)
  type           String? @db.VarChar(50)
  slug           String? @db.VarChar(255)
  name_with_type String? @db.VarChar(255)
  path           String? @db.VarChar(255)
  path_with_type String? @db.VarChar(255)
  parent_code    String? @db.VarChar(10)
  cities         cities? @relation(fields: [parent_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  posts          posts[]
}

model posts {
  id            Int     @id @default(autoincrement())
  sourceId      String? @unique
  title         String  @db.VarChar(255)
  thumbnail     String?
  price         Decimal @db.Decimal
  area          Decimal @db.Decimal
  city          String? @db.VarChar(10)
  district      String? @db.VarChar(10)
  content       String?

  ward          String?
  addressDetail String?
  bedrooms      Int?
  bathrooms     Int?
  direction     String?
  floors        Int?
  length        Float?
  width         Float?
  legalDocument String?
  furnishing    String?
  sellerName    String?

  posterType       PosterType @default(OWNER) 
  brokerCommission Float?     

  transactionType TransactionType @default(SALE)
  status          ListingStatus   @default(PENDING)

  userId     String?
  categoryId Int?

  cities    cities?    @relation(fields: [city], references: [code], onDelete: NoAction, onUpdate: NoAction)
  districts districts? @relation(fields: [district], references: [code], onDelete: NoAction, onUpdate: NoAction)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category?  @relation(fields: [categoryId], references: [id])

  images     Image[]
  favorites  Favorite[]
  reports    Report[]
  transactions Transaction[]
  comments     Comment[]
  reviews      PostReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ============================================================
// SECURITY TOOL
// ============================================================

enum SecurityAction {
  ALLOW
  ALERT
  BLOCK
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AttackType {
  SQL_INJECTION
  XSS
  BRUTE_FORCE
  API_ABUSE
  UNAUTHORIZED_ACCESS
  SUSPICIOUS_REQUEST
}

// Lưu lịch sử các hành vi tấn công
model SecurityEvent {
  id Int @id @default(autoincrement())

  ipAddress String? @db.VarChar(64)

  // clientKey giúp nhận diện client kể cả khi IP thay đổi
  clientKey String? @db.VarChar(128)

  // Có thể null vì attacker chưa chắc đã đăng nhập
  userId String?

  userAgent String?
  method    String @db.VarChar(10)
  path      String

  attackType AttackType
  severity   SecuritySeverity
  riskScore  Int

  action SecurityAction

  reason String?

  createdAt DateTime @default(now())

  @@index([ipAddress])
  @@index([clientKey])
  @@index([userId])
  @@index([attackType])
  @@index([createdAt])
  @@map("security_events")
}

// Theo dõi số lần vi phạm
model ClientViolation {
  id Int @id @default(autoincrement())

  clientKey String @unique @db.VarChar(128)

  ipAddress String? @db.VarChar(64)

  violationCount Int @default(0)
  totalRisk      Int @default(0)

  lastAttackType AttackType?

  firstViolationAt DateTime @default(now())
  lastViolationAt  DateTime @updatedAt

  @@index([ipAddress])
  @@map("security_client_violations")
}

// Danh sách IP / client đang bị khóa
model BlockedIp {
  id Int @id @default(autoincrement())

  ipAddress String? @db.VarChar(64)

  clientKey String? @db.VarChar(128)

  reason String

  violationCount Int @default(0)
  totalRisk      Int @default(0)

  isActive Boolean @default(true)

  blockedAt DateTime @default(now())
  expiresAt DateTime?

  @@index([ipAddress])
  @@index([clientKey])
  @@index([isActive])
  @@map("security_blocked_ips")
}
model SecurityStats {
  id            Int      @id @default(1)
  totalRequests Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@map("security_stats")
}
model SecurityRateLimit {
  id Int @id @default(autoincrement())

  clientKey String @db.VarChar(128)
  endpoint  String @db.VarChar(255)

  requestCount Int @default(0)

  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clientKey, endpoint])
  @@index([clientKey])
  @@index([windowStart])
  @@map("security_rate_limits")
}
model SecurityLoginAttempt {
  id Int @id @default(autoincrement())

  // Client thực hiện đăng nhập
  clientKey String @db.VarChar(128)

  // Hash email/username, không lưu password
  identifierHash String @db.VarChar(64)

  // Endpoint đăng nhập
  endpoint String @db.VarChar(255)

  // Số lần đăng nhập thất bại
  failedCount Int @default(0)

  // Thời điểm bắt đầu cửa sổ theo dõi
  windowStart DateTime @default(now())

  // Nếu bị chặn đăng nhập tạm thời
  blockedUntil DateTime?

  updatedAt DateTime @updatedAt

  @@unique([clientKey, identifierHash, endpoint])
  @@index([clientKey])
  @@index([identifierHash])
  @@index([blockedUntil])
  @@map("security_login_attempts")
}
