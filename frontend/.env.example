# Socket.IO connects directly to NestJS; REST stays on the Security Gateway.
# Local backend defaults to port 3001. Production: use your verified Render backend URL.
NEXT_PUBLIC_WS_URL=http://localhost:3001
# Vercel example: NEXT_PUBLIC_WS_URL=https://quanghuy-backend.onrender.com
# Keep your existing NEXT_PUBLIC_API_URL and Supabase settings.
